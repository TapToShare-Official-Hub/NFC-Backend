# Copy this file to .env.local and fill in real values.
# These are server-side only (no NEXT_PUBLIC_ prefix) — never exposed to the browser.

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Supabase project URL — Project Settings → Data API → Project URL
# Use the BARE project URL: no "/rest/v1" path, no trailing slash.
# supabase-js adds "/rest/v1/..." itself; adding it here breaks every query
# with "PGRST125 Invalid path specified in request URL".
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — Project Settings → API Keys → anon public
SUPABASE_ANON_KEY=eyJhbGciOi...

# myaibot.vip bridge key for Xiaohongshu direct-publish. Metered and
# server-side ONLY — never sent to the browser. Not needed while DEV_MOCK_XHS
# is "true" below.
MYAIBOT_API_KEY=

# DEV SAFETY: when "true", /api/xhs/publish returns a fake url and NEVER calls
# myaibot, so nobody burns the limited credit balance during development/demos.
# Default it to "true". Flip to "false" ONLY when you intend to spend a credit
# on a real publish.
DEV_MOCK_XHS=true
